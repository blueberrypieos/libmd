#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

GEN     := $(OBJ)/gen
HL      := md4 md5 sha sha1 sha224 sha256 sha384 sha512
OBJS    := $(patsubst %,$(OBJ)/%hl.o,$(HL)) $(OBJ)/sha0.o
DYLIB   := $(OBJ)/libmd.dylib
FLAGS   := $(BASE_CFLAGS) -I$(CURDIR)/debian -I$(SRCROOT)/include -I$(SRCROOT)/libmd -isystem $(SDK)/usr/local/include

all: $(DYLIB)

LEN_md4    := 16
LEN_md5    := 16
LEN_sha    := 20
LEN_sha1   := 20
LEN_sha224 := 28
LEN_sha256 := 32
LEN_sha384 := 48
LEN_sha512 := 64
ID_md4     := MD4
ID_md5     := MD5
ID_sha     := SHA_
ID_sha1    := SHA1_
ID_sha224  := SHA224_
ID_sha256  := SHA256_
ID_sha384  := SHA384_
ID_sha512  := SHA512_

$(GEN)/%hl.c: $(SRCROOT)/libmd/mdXhl.c
	@mkdir -p $(GEN)
	{ printf '#define LENGTH %s\n' $(LEN_$*); \
	  sed -e 's/mdX/$*/g' -e 's/MDX_/$(ID_$*)$(if $(filter md%,$*),_)/g' -e 's/MDX/$(ID_$*)/g' \
	      $(if $(filter sha1,$*),-e 's/sha1\.h/sha.h/') $<; } > $@

$(OBJ)/%.o: $(GEN)/%.c
	$(CC) $(FLAGS) -c $< -o $@
$(OBJ)/sha0.o: debian/sha0.c
	@mkdir -p $(OBJ)
	$(CC) $(FLAGS) -c $< -o $@

$(DYLIB): $(OBJS)
	$(CC) $(BASE_LDFLAGS) -dynamiclib -install_name /usr/lib/libmd.dylib \
		-compatibility_version 1 -current_version 1 $(OBJS) -o $@

install: $(DYLIB)
	install -d $(ROOT)/usr/lib $(ROOT)/usr/include
	install -m 755 $(DYLIB) $(ROOT)/usr/lib/
	install -m 644 $(addprefix $(SRCROOT)/libmd/,md4.h md5.h) debian/sha.h \
		$(addprefix $(SRCROOT)/include/,sha224.h sha256.h sha384.h sha512.h) $(ROOT)/usr/include/

.PHONY: all install
